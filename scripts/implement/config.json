{
  "agent": {
    "models": {
      "implementer": null,
      "bugTriage": "opus"
    }
  },
  "modelClasses": {
    "small": "sonnet",
    "medium": "sonnet",
    "large": "opus"
  },
  "implement": {
    "worktreeDir": "../{repo}-worktrees",
    "branchPrefix": "feat/",
    "delivery": "epic",
    "epic": {
      "branchPrefix": "epic/",
      "bugfixPrefix": "bugfix/",
      "grouping": "auto",
      "planTimeoutSec": 1800,
      "qe": true,
      "prCheck": "report",
      "prCheckTimeoutSec": 14400
    },
    "maxBugsPerGroup": null,
    "parallel": "auto",
    "implementerTimeoutSec": 5400,
    "maxImplementerRuns": 8,
    "maxBugFixCycles": 2,
    "qeTimeoutSec": 14400,
    "qePollSec": 5,
    "maxWorkerRetries": 2,
    "retryDelaySec": 30,
    "orchestrate": true,
    "maxSubtasks": 4,
    "selfModeMaxFiles": 6,
    "maxConcurrentPairs": 2,
    "maxConcurrentAgents": 6,
    "maxPairRounds": 3,
    "maxTakeovers": 1,
    "maxLargeSubtasks": 1,
    "maxAgentRunsPerStory": 20,
    "storyWallClockSec": 10800,
    "timeouts": {
      "plannerSec": 1800,
      "orchestratorSec": 3600,
      "pairImplementerSec": 1800,
      "codeVerifierSec": 600,
      "uiVerifierSec": 1200,
      "checkSec": 1800
    },
    "roles": {
      "orchestrator": {
        "cli": null,
        "modelClass": "large"
      },
      "pairImplementer": {
        "cli": null
      },
      "verifier": {
        "cli": null,
        "modelClass": "medium"
      },
      "uiVerifier": {
        "cli": null,
        "modelClass": "large"
      }
    },
    "prepareCmd": "export PATH=$HOME/.dotnet:$PATH && dotnet restore eShop.Web.slnf -v q",
    "checks": [
      {
        "name": "build",
        "cmd": "export PATH=$HOME/.dotnet:$PATH && dotnet build eShop.Web.slnf -nologo -v q -clp:ErrorsOnly"
      }
    ],
    "unitTests": {
      "project": "tests/{service}.UnitTests",
      "cmd": "export PATH=$HOME/.dotnet:$PATH && dotnet test --project {project}"
    },
    "ui": {
      "slotsCmd": [
        "node",
        "scripts/stack/slots.mjs"
      ],
      "teststackCmd": [
        "testing/teststack"
      ],
      "leaseWaitSec": 300,
      "leaseRetrySec": 30,
      "stackTimeoutSec": 2400,
      "screenshotsDir": "artifacts/pairs",
      "renewEverySec": 1800
    },
    "lsp": {
      "enabled": true,
      "setupCmd": [
        "sh",
        "scripts/lsp/setup.sh"
      ],
      "lspdCmd": [
        "node",
        "scripts/lsp/lspd.mjs"
      ],
      "slnfCmd": [
        "node",
        "scripts/lsp/slnf.mjs"
      ],
      "timeoutSec": 300
    },
    "decisions": {
      "smallDiffLoc": 60,
      "tinySubtaskLoc": 40,
      "tinySubtaskFiles": 3,
      "selfMaxTotalLoc": 150,
      "selfOverheadRunsPerSubtask": 2
    },
    "reviewGate": {
      "enabled": true,
      "timeoutSec": 900,
      "maxDiffChars": 120000,
      "systems": [
        {
          "name": "Catalog.API",
          "paths": [
            "src/Catalog.API/**"
          ]
        },
        {
          "name": "Basket.API",
          "paths": [
            "src/Basket.API/**"
          ]
        },
        {
          "name": "Ordering.API",
          "paths": [
            "src/Ordering.API/**",
            "src/Ordering.Domain/**",
            "src/Ordering.Infrastructure/**"
          ]
        },
        {
          "name": "Identity.API",
          "paths": [
            "src/Identity.API/**"
          ]
        },
        {
          "name": "Webhooks.API",
          "paths": [
            "src/Webhooks.API/**"
          ]
        },
        {
          "name": "Promotions.API",
          "paths": [
            "src/Promotions.API/**"
          ]
        },
        {
          "name": "WebApp",
          "paths": [
            "src/WebApp/**",
            "src/WebAppComponents/**"
          ]
        },
        {
          "name": "WebhookClient",
          "paths": [
            "src/WebhookClient/**"
          ]
        },
        {
          "name": "OrderProcessor",
          "paths": [
            "src/OrderProcessor/**"
          ]
        },
        {
          "name": "PaymentProcessor",
          "paths": [
            "src/PaymentProcessor/**"
          ]
        },
        {
          "name": "Mobile clients",
          "paths": [
            "src/ClientApp/**",
            "src/HybridApp/**"
          ]
        },
        {
          "name": "Integration events",
          "paths": [
            "src/**/IntegrationEvents/Events/**"
          ],
          "shared": true,
          "contract": true
        },
        {
          "name": "EventBus",
          "paths": [
            "src/EventBus/**",
            "src/EventBusRabbitMQ/**",
            "src/IntegrationEventLogEF/**"
          ],
          "shared": true
        },
        {
          "name": "ServiceDefaults",
          "paths": [
            "src/eShop.ServiceDefaults/**",
            "src/Shared/**"
          ],
          "shared": true
        },
        {
          "name": "AppHost",
          "paths": [
            "src/eShop.AppHost/**"
          ],
          "shared": true
        },
        {
          "name": "Build",
          "paths": [
            "Directory.Build.props",
            "Directory.Build.targets",
            "Directory.Packages.props",
            "global.json",
            "nuget.config"
          ],
          "shared": true
        }
      ],
      "ignore": [
        "tests/**",
        "e2e/**",
        "testing/**",
        "docs/**",
        ".agent-metrics/**",
        ".github/agents/lessons/**",
        "graphify-out/**",
        "**/*.md"
      ],
      "floor": {
        "level": "High",
        "paths": [
          "src/Identity.API/**",
          "src/PaymentProcessor/**",
          "**/Migrations/**",
          ".github/workflows/**",
          ".github/CODEOWNERS",
          "scripts/review-gate/**"
        ],
        "categories": [
          "auth",
          "payments",
          "migration",
          "security"
        ]
      },
      "manySystems": 3,
      "sharedFloor": "High",
      "confidence": {
        "highMin": 85,
        "maxPairRounds": 2,
        "maxPrCheckRounds": 2,
        "agentWeight": 0.2
      },
      "approvals": {
        "default": 1,
        "Low": 1,
        "Medium": 1,
        "High": 1,
        "Severe": 1
      },
      "labels": {
        "approvals": "approvals:{n}",
        "needsHuman": "needs-human",
        "autoMerged": "auto-merged",
        "reopened": "reopened"
      },
      "substantiveCommentChars": 20,
      "retro": {
        "minSample": 5,
        "raiseFindRate": 0.3,
        "raiseEscapeRate": 0.2,
        "lowerFindRate": 0.05
      }
    },
    "autoMerge": {
      "enabled": true,
      "identity": "gh-user",
      "method": "squash",
      "appTokenEnv": "REVIEW_GATE_APP_TOKEN"
    }
  },
  "resources": {
    "reserveGb": 6,
    "worktreeGb": 3,
    "agentGb": 0.5,
    "roslynGb": 0.8,
    "stackGb": 1.6,
    "dockerOverheadGb": 1,
    "maxParallel": null,
    "waitPollSec": 15,
    "maxWaitSec": 1800
  }
}
