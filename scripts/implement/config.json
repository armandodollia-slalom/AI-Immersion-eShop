{
  "agent": {
    "models": {
      "implementer": null
    }
  },
  "modelClasses": {
    "claude": {
      "small": "claude-sonnet-5-5",
      "medium": "claude-sonnet-5-5",
      "large": "claude-opus-5-5"
    },
    "copilot": {
      "small": "claude-sonnet-5.5",
      "medium": "claude-sonnet-5.5",
      "large": "claude-opus-5.5"
    },
    "codex": {
      "small": null,
      "medium": null,
      "large": null
    }
  },
  "implement": {
    "worktreeDir": "../{repo}-worktrees",
    "branchPrefix": "feat/",
    "parallel": 1,
    "implementerTimeoutSec": 5400,
    "maxImplementerRuns": 8,
    "maxBugFixCycles": 2,
    "qeTimeoutSec": 14400,
    "qePollSec": 5,
    "orchestrate": true,
    "maxSubtasks": 4,
    "selfModeMaxFiles": 6,
    "maxConcurrentPairs": 2,
    "maxConcurrentAgents": 6,
    "maxPairRounds": 3,
    "maxTakeovers": 1,
    "maxLargeSubtasks": 1,
    "maxAgentRunsPerStory": 20,
    "storyWallClockSec": 10800,
    "timeouts": {
      "plannerSec": 1800,
      "orchestratorSec": 3600,
      "pairImplementerSec": 1800,
      "codeVerifierSec": 600,
      "uiVerifierSec": 1200,
      "checkSec": 1800
    },
    "roles": {
      "orchestrator": {
        "cli": null,
        "modelClass": "large"
      },
      "pairImplementer": {
        "cli": null
      },
      "verifier": {
        "cli": null,
        "modelClass": "medium"
      },
      "uiVerifier": {
        "cli": null,
        "modelClass": "large"
      }
    },
    "prepareCmd": "export PATH=$HOME/.dotnet:$PATH && dotnet restore eShop.Web.slnf -v q",
    "checks": [
      {
        "name": "build",
        "cmd": "export PATH=$HOME/.dotnet:$PATH && dotnet build eShop.Web.slnf -nologo -v q -clp:ErrorsOnly"
      }
    ],
    "unitTests": {
      "project": "tests/{service}.UnitTests",
      "cmd": "export PATH=$HOME/.dotnet:$PATH && dotnet test --project {project}"
    },
    "ui": {
      "slotsCmd": [
        "node",
        "scripts/stack/slots.mjs"
      ],
      "teststackCmd": [
        "testing/teststack"
      ],
      "leaseWaitSec": 300,
      "leaseRetrySec": 30,
      "stackTimeoutSec": 2400,
      "screenshotsDir": "artifacts/pairs",
      "renewEverySec": 1800
    },
    "lsp": {
      "enabled": true,
      "setupCmd": [
        "sh",
        "scripts/lsp/setup.sh"
      ],
      "lspdCmd": [
        "node",
        "scripts/lsp/lspd.mjs"
      ],
      "slnfCmd": [
        "node",
        "scripts/lsp/slnf.mjs"
      ],
      "timeoutSec": 300
    },
    "decisions": {
      "smallDiffLoc": 60,
      "tinySubtaskLoc": 40,
      "tinySubtaskFiles": 3,
      "selfMaxTotalLoc": 150,
      "selfOverheadRunsPerSubtask": 2
    }
  }
}
