{
  "plansDir": "tests/plans",
  "scenariosDir": "testing/scenarios",
  "agent": {
    "models": {
      "plan": null,
      "automation": "sonnet",
      "verifier": null,
      "audit": null
    }
  },
  "loops": {
    "requiredScore": 9,
    "consecutivePasses": 1,
    "planMaxRounds": 5,
    "automationMaxRounds": 5
  },
  "timeoutsSec": {
    "plan": 1800,
    "automation": 3600,
    "verifier": 900,
    "lessons": 1200,
    "tests": 1800
  },
  "lessons": {
    "storyThreshold": 3,
    "maxRules": 15,
    "retireAfterStories": 10,
    "revertMinRounds": 6,
    "intervalDays": 7,
    "examplesPerCategory": 5,
    "retro": {
      "enabled": true,
      "windowDays": 7,
      "allowedPaths": [
        ".github/agents/",
        ".claude/agents/",
        "docs/",
        "architecture-policy/"
      ]
    }
  },
  "testRoots": [
    "e2e",
    "tests",
    "testing/scenarios"
  ],
  "testExtensions": [
    ".ts",
    ".cs"
  ],
  "evidence": {
    "manifest": "artifacts/e2e-videos/manifest.json"
  },
  "precheck": {
    "runTests": true,
    "fix": {
      ".md": ["node_modules/.bin/markdownlint", "--fix", "{files}"],
      ".ts": ["node_modules/.bin/eslint", "--fix", "--no-warn-ignored", "{files}"],
      ".cs": ["dotnet", "format", "whitespace", "--folder", "--include", "{files}"]
    },
    "lint": {
      ".md": [
        "node_modules/.bin/markdownlint",
        "{files}"
      ],
      ".ts": [
        "node_modules/.bin/eslint",
        "--no-warn-ignored",
        "{files}"
      ],
      ".cs": [
        "dotnet",
        "format",
        "whitespace",
        "--folder",
        "--verify-no-changes",
        "--include",
        "{files}"
      ]
    },
    "validateScenario": [
      "testing/teststack",
      "validate",
      "{scenario}"
    ],
    "playwright": [
      "npx",
      "playwright",
      "test",
      "-c",
      "playwright.teststack.config.ts",
      "--grep",
      "{casePrefix}",
      "{files}"
    ],
    "dotnetBuild": [
      "dotnet",
      "build",
      "{project}",
      "--nologo",
      "-v",
      "quiet"
    ],
    "dotnet": {
      "xunit": [
        "dotnet",
        "test",
        "--project",
        "{project}",
        "--no-build",
        "--",
        "--filter-trait",
        "Story={story}"
      ],
      "mstest": [
        "dotnet",
        "test",
        "--project",
        "{project}",
        "--no-build",
        "--filter",
        "TestCategory={story}"
      ]
    }
  },
  "categories": {
    "plan": [
      "ac-not-covered",
      "missing-sad-path",
      "untestable-expectation",
      "invented-requirement",
      "vague-steps",
      "duplicate-case",
      "stale-vs-story",
      "other"
    ],
    "automation": [
      "case-not-covered",
      "tests-different-path",
      "wrong-assertion",
      "missing-assertion",
      "missing-setup",
      "over-mocked",
      "flaky-wait",
      "wrong-layer",
      "visual-mismatch",
      "other"
    ],
    "sadPathSubtypes": [
      "validation",
      "auth",
      "ownership",
      "not-found",
      "boundary",
      "concurrency",
      "conflict",
      "dependency-failure"
    ]
  },
  "useSlots": true
}
