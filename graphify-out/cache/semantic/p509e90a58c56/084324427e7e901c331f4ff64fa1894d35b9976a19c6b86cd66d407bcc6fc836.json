{"nodes": [{"id": "docs_ai_pipeline_setup", "label": "Setting up the pipeline", "file_type": "document", "source_file": "docs/ai-pipeline/setup.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_ai_pipeline_setup_prerequisites", "label": "Pipeline Prerequisites (Git, Node 20, agent CLI, Python, graphify, .NET, Playwright, gh, ffmpeg)", "file_type": "document", "source_file": "docs/ai-pipeline/setup.md", "source_location": "## Prerequisites", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_ai_pipeline_setup_macos_setup", "label": "macOS Setup", "file_type": "document", "source_file": "docs/ai-pipeline/setup.md", "source_location": "## macOS", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_ai_pipeline_setup_windows_setup", "label": "Windows Setup", "file_type": "document", "source_file": "docs/ai-pipeline/setup.md", "source_location": "## Windows", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "scripts/setup.sh targets macOS and Linux, so Windows users install tools with WinGet; prefer native .exe agent CLIs because some pipeline calls start the CLI without a shell and cannot run npm .cmd shims.", "_origin": "semantic"}, {"id": "docs_ai_pipeline_setup_both_platforms", "label": "Both Platforms Setup (trust hooks, agent.cli, pipeline self-check)", "file_type": "document", "source_file": "docs/ai-pipeline/setup.md", "source_location": "## Both platforms", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_ai_pipeline_setup_pipeline_pr_bot", "label": "Pipeline PR Bot (dev-bot-<login> GitHub App)", "file_type": "concept", "source_file": "docs/ai-pipeline/setup.md", "source_location": "## The pipeline's PR bot", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GitHub never lets a PR's author approve it, so pipeline PRs are opened by a per-developer GitHub App; the developer can then approve via normal review and review-quorum counts the approval. Only the PR author changes; commits and other gh calls stay the developer's.", "_origin": "semantic"}, {"id": "docs_ai_pipeline_setup_bot_setup_command", "label": "pipeline bot setup", "file_type": "concept", "source_file": "docs/ai-pipeline/setup.md", "source_location": "### One-time setup (per developer)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires two browser clicks (Create, Install) because GitHub does not let a script create or install an App.", "_origin": "semantic"}, {"id": "docs_ai_pipeline_setup_bot_status_command", "label": "pipeline bot status", "file_type": "concept", "source_file": "docs/ai-pipeline/setup.md", "source_location": "### One-time setup (per developer)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_ai_pipeline_setup_bot_credentials", "label": "Bot Credentials Storage (~/.config/eshop-pipeline)", "file_type": "concept", "source_file": "docs/ai-pipeline/setup.md", "source_location": "### Where the credentials live", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Credentials live outside the repo with 0600 perms; the client secret is not saved; short-lived installation tokens are passed via GH_TOKEN and HTTP header env so the token never appears on a command line, URL, log or error.", "_origin": "semantic"}, {"id": "docs_ai_pipeline_setup_bot_settings", "label": "Bot Settings (bot.enabled, namePattern, credentialsDir, PIPELINE_BOT_* env)", "file_type": "concept", "source_file": "docs/ai-pipeline/setup.md", "source_location": "### Settings", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_ai_pipeline_setup_bot_rotate_revoke", "label": "Rotate or Revoke Bot Key", "file_type": "document", "source_file": "docs/ai-pipeline/setup.md", "source_location": "### Rotate or revoke", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_ai_pipeline_setup_optional_settings", "label": "Optional Settings (qe.autoPlan, qe.autoLessons, PIPELINE_BASE_REF, PIPELINE_DISABLE, QE_SKIP)", "file_type": "document", "source_file": "docs/ai-pipeline/setup.md", "source_location": "## Optional settings", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_ai_pipeline_setup_review_gate_setup", "label": "Review Gate Setup for Bug-fix PRs", "file_type": "document", "source_file": "docs/ai-pipeline/setup.md", "source_location": "## Review gate for bug-fix PRs", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repository settings are the owner's call and the gate never changes them; a ruleset bypass identity is needed only once main requires human approvals so Low PRs needing none can still merge.", "_origin": "semantic"}, {"id": "docs_ai_pipeline_setup_review_quorum", "label": "review-quorum status check", "file_type": "concept", "source_file": "docs/ai-pipeline/setup.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Required status check on main enforces each PR's approvals:N label.", "_origin": "semantic"}, {"id": "docs_ai_pipeline_setup_auto_merge", "label": "implement.autoMerge (identity: bot/app)", "file_type": "concept", "source_file": "docs/ai-pipeline/setup.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "