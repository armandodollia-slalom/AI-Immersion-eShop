{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenApi": {
    "Endpoint": {
      "Name": "Promotions.API V1"
    },
    "Document": {
      "Description": "The Promotions Microservice HTTP API. Lists active promotions and manages promotion data.",
      "Title": "eShop - Promotions HTTP API",
      "Version": "v1"
    }
  },
  "ConnectionStrings": {
    "EventBus": "amqp://localhost"
  },
  "EventBus": {
    "SubscriptionClientName": "Promotions"
  },
  "Identity": {
    "Url": "http://localhost:5223",
    "Audience": "promotions",
    "Scopes": {
      "promotions": "Promotions API"
    }
  }
}
