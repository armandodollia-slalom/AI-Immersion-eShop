{
  "tickets": {
    "dir": ".agent-state/board",
    "repo": "armandodollia-slalom/AI-Immersion-eShop",
    "assetsBranch": "board-assets",
    "spikeEpic": { "key": "epic-targeted-advertising", "title": "Targeted Advertising" }
  },
  "stateDir": ".agent-state",
  "metricsDir": ".agent-metrics",
  "agentsDir": ".github/agents",
  "lessonsDir": ".github/agents/lessons",
  "baseRef": "origin/main",
  "storyGuard": {
    "folders": [".agent-state/board"]
  },
  "agent": {
    "cli": "claude",
    "allowedModels": ["opus", "sonnet", "sol"],
    "modelIds": {
      "claude": { "opus": "claude-opus-5-5", "sonnet": "claude-sonnet-5-5" },
      "copilot": { "opus": "claude-opus-5.5", "sonnet": "claude-sonnet-5.5", "sol": "gpt-6.1-sol" }
    },
    "strictModels": true,
    "models": {
      "default": "sonnet"
    },
    "resultParseRetries": 1
  },
  "recovery": {
    "maxAttempts": 3,
    "backoffSec": 60,
    "startingGraceSec": 120
  },
  "implExclude": [
    "tests",
    "e2e",
    "testing/scenarios",
    ".agent-metrics",
    ".agent-state",
    "graphify-out",
    ".github/agents/lessons"
  ],
  "dashboard": {
    "rate": 220,
    "timeZone": "America/Chicago",
    "tzLabel": "CST",
    "idleGapMin": 30,
    "out": "artifacts/dashboards",
    "afterRun": true,
    "publishAfterRun": false,
    "pages": {
      "teststack-bug-findings": {
        "epic": "renuka-tumati/epic64-dashboard",
        "story": "renuka-tumati/epic64-story-dashboard"
      }
    },
    "runLog": {
      "teststack-bug-findings": {
        "label": "run log PR #96",
        "url": "https://github.com/armandodollia-slalom/AI-Immersion-eShop/pull/96"
      }
    }
  }
}
